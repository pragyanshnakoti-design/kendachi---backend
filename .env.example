DB_HOST=localhost
DB_PORT=5432
DB_NAME=kendachi
DB_USER=kendachi
DB_PASSWORD=kendachi_secret

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=Kendachi <no-reply@yourdomain.com>

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:4173
ALLOW_VERCEL_PREVIEWS=false

OTP_EXPIRES_MINUTES=2
OTP_REQUEST_WINDOW_MINUTES=2
OTP_REQUEST_MAX=4
OTP_VERIFY_WINDOW_MINUTES=5
OTP_VERIFY_MAX=12
OTP_VERIFY_ATTEMPTS=4
MAX_ACTIVE_LOGIN_SESSIONS=4

IDLE_TIMEOUT_MINUTES=1
REGULAR_HOURS_LIMIT=0.0167
COMPANY_SESSION_MINUTES=5
HEARTBEAT_INTERVAL_SECONDS=5
IDLE_THRESHOLD_SECONDS=10
PRESENCE_INTERVAL_SECONDS=60
PRESENCE_RESPONSE_SECONDS=15
HIDDEN_ALERT_SECONDS=30

USE_IN_MEMORY_DB=false
